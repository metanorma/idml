CrossReference_Object = element CrossReference {
    attribute Self { xsd:string },
    attribute ReferencedTopic { xsd:string }?,
    attribute CrossReferenceType { CrossReferenceType_EnumValue }?,
    attribute CustomTypeString { xsd:string }?,
