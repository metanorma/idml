MarginPreference_Object = element MarginPreference { attribute ColumnCount { xsd:int {minInclusive="1" maxInclusive="216" } }?,
    attribute Top { xsd:double }?,
    attribute Bottom { xsd:double }?,
    attribute Left { xsd:double }?,
    attribute Right { xsd:double }?,
    attribute ColumnDirection { HorizontalOrVertical_EnumValue }?,
    attribute ColumnsPositions { list { xsd:double * } }? attribute ColumnGutter { xsd:double {minInclusive="0" maxInclusive="1440" } }? }
